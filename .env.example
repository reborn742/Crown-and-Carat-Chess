# Crown & Carat Chess needs NO API keys and NO secrets.
# Everything below is optional server configuration.

# Number of reverse proxies in front of the server (Cloud Run = 1, local = 0).
# Used for per-IP rate limiting. Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1

# Extra origins allowed to open the multiplayer WebSocket (comma separated),
# for example when you serve the game from your own domain.
# ALLOWED_ORIGINS=https://chess.example.com

# Who may embed the game in an <iframe> (production only). Default: this site plus Google AI Studio domains.
# FRAME_ANCESTORS='self' https://aistudio.google.com
